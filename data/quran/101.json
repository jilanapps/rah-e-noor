{"n": 101, "ayahs": [{"n": 1, "ar": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ", "ur": "کھڑ کھڑانے والی"}, {"n": 2, "ar": "مَا ٱلْقَارِعَةُ", "ur": "کھڑ کھڑانے والی کیا ہے؟"}, {"n": 3, "ar": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ", "ur": "اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟"}, {"n": 4, "ar": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ", "ur": "(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے"}, {"n": 5, "ar": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ", "ur": "اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون"}, {"n": 6, "ar": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ", "ur": "تو جس کے (اعمال کے) وزن بھاری نکلیں گے"}, {"n": 7, "ar": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "ur": "وہ دل پسند عیش میں ہو گا"}, {"n": 8, "ar": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ", "ur": "اور جس کے وزن ہلکے نکلیں گے"}, {"n": 9, "ar": "فَأُمُّهُۥ هَاوِيَةٌۭ", "ur": "اس کا مرجع ہاویہ ہے"}, {"n": 10, "ar": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ", "ur": "اور تم کیا سمجھے کہ ہاویہ کیا چیز ہے؟"}, {"n": 11, "ar": "نَارٌ حَامِيَةٌۢ", "ur": "دہکتی ہوئی آگ ہے"}]}